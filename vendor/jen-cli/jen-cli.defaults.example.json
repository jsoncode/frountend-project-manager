{
  "cliDefaults": {
    "server": "tx",
    "job": "",
    "intervalMs": 3000,
    "console": true
  },
  "paramKeys": {},
  "paramDefaults": {
    "branch": "uat5",
    "NodeVersion": "v24.12.0",
    "INSTALL_COMMAND_ACTIVE": "pnpm i",
    "BUILD_COMMAND_ACTIVE": "pnpm build:uat",
    "project": ""
  },
  "presets": {
    "rules": [
      {
        "whenServer": ["tx"],
        "whenJob": [
          "system3_Front_docker1",
          "system3_Front_docker2",
          "system3_Front_docker3",
          "system3_Front_docker4"
        ],
        "requireProject": true,
        "defaultJob": "system3_Front_docker3",
        "defaults": {
          "branch": "uat5",
          "NodeVersion": "v24.12.0",
          "INSTALL_COMMAND_ACTIVE": "pnpm i",
          "BUILD_COMMAND_ACTIVE": "pnpm build:uat"
        }
      },
      {
        "whenServer": ["txProd"],
        "whenJob": ["pro_system3_Front_docker3"],
        "requireProject": false,
        "defaultJob": "pro_system3_Front_docker3",
        "defaults": {
          "branch": "master5",
          "NodeVersion": "v24.12.0",
          "INSTALL_COMMAND_ACTIVE": "pnpm i",
          "BUILD_COMMAND_ACTIVE": "pnpm build:prod"
