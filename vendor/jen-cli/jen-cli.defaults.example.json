{
  "cliDefaults": {
    "server": "tx",
    "job": "",
    "intervalMs": 3000,
    "console": true
  },
  "paramKeys": {
    "branch": "branch",
    "nodeVersion": "NodeVersion",
    "installCommand": "INSTALL_COMMAND_ACTIVE",
    "buildCommand": "BUILD_COMMAND_ACTIVE",
    "project": "project"
  },
  "paramDefaults": {
    "branch": "uat5",
    "nodeVersion": "v24.12.0",
    "installCommand": "pnpm i",
    "buildCommand": "pnpm build:uat",
    "project": ""
  },
  "presets": {
    "rules": [
      {
        "whenServer": ["tx"],
        "whenJob": [
          "system3_Front_docker1",
          "system3_Front_docker2",
          "system3_Front_docker3",
          "system3_Front_docker4"
        ],
        "requireProject": true,
        "defaultJob": "system3_Front_docker3",
        "defaults": {
          "branch": "uat5",
          "nodeVersion": "v24.12.0",
          "installCommand": "pnpm i",
          "buildCommand": "pnpm build:uat"
        }
      },
      {
        "whenServer": ["txProd"],
        "whenJob": ["pro_system3_Front_docker3"],
        "requireProject": false,
        "defaultJob": "pro_system3_Front_docker3",
        "defaults": {
          "branch": "master5",
          "nodeVersion": "v24.12.0",
          "installCommand": "pnpm i",
          "buildCommand": "pnpm build:prod"
        }
      }
    ]
  }
}
