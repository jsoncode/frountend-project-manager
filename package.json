{
  "name": "frontend-project-manager",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/setup-nsis.mjs && tauri build",
    "tauri:build:win": "node scripts/setup-nsis.mjs && tauri build --bundles nsis",
    "nsis:setup": "node scripts/setup-nsis.mjs",
    "tauri:build:mac": "tauri build --bundles dmg",
    "tauri:build:mac:app": "tauri build --bundles app",
    "tauri:build:mac:universal": "tauri build --target universal-apple-darwin --bundles dmg",
    "version:sync": "node scripts/sync-version.mjs",
    "release": "node scripts/release-tag.mjs",
    "release:tag-only": "node scripts/release-tag.mjs --tag-only",
    "tauri:preview": "tauri preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.0",
    "monaco-editor": "0.52.2",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reicon-react": "^1.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.77.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
