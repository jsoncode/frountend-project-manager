{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-chat-window",
  "description": "Least-privilege capability for the ai-chat window: no filesystem, git, terminal or dialog permissions (M9)",
  "windows": ["ai-chat"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-center",
    "allow-load-config",
    "allow-save-config",
    "allow-ai-load-config",
    "allow-ai-save-config",
    "allow-ai-list-conversations",
    "allow-ai-get-messages",
    "allow-ai-create-conversation",
    "allow-ai-rename-conversation",
    "allow-ai-delete-conversation",
    "allow-ai-append-message",
    "allow-ai-update-message",
    "allow-ai-delete-message",
    "allow-ai-open-chat-window",
    "allow-ai-take-pending-feed",
    "allow-ai-chat-start",
    "allow-ai-chat-cancel",
    "allow-ai-generate-title"
  ]
}
