    "allow-git-checkout",
    "allow-git-create-branch",
    "allow-git-delete-branch",
    "allow-git-fetch",
    "allow-git-pull-branch",
    "allow-git-merge-status",
    "allow-git-merge-start",
    "allow-git-merge-file-sides",
