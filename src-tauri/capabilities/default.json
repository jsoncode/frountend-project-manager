{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for FPM",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:tray:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "dialog:default",
    "shell:allow-open",
    "allow-load-config",
    "allow-save-config",
    "allow-list-projects",
    "allow-scan-project",
    "allow-git-branches",
    "allow-git-status",
    "allow-git-checkout",
    "allow-git-fetch",
    "allow-list-env-files",
    "allow-read-env-file",
    "allow-run-command",
    "allow-kill-command",
    "allow-write-terminal-stdin",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-pty-interrupt",
    "allow-preview-file",
    "allow-detect-ides",
    "allow-list-installed-editors",
    "allow-open-in-ide",
    "allow-save-ides",
    "allow-set-project-tags",
    "allow-touch-command-history",
    "allow-touch-branch-history",
    "allow-touch-search-history",
    "allow-touch-project-access",
    "allow-set-history-pinned",
    "core:window:allow-center",
    "allow-delete-history",
    "allow-set-locale",
    "allow-pick-directory",
    "allow-pick-executable",
    "allow-pick-image",
    "allow-import-ide-icon",
    "allow-import-ide-icon-bytes",
    "allow-extract-ide-icon-from-exe"
  ]
}
