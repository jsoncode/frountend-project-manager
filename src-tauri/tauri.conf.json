{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Frontend Project Manager",
  "version": "0.4.5",
  "identifier": "com.fpm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "FPM — Frontend Project Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPCONFIG/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": [
      "../vendor/jen-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
